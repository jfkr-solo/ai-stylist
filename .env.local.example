# 未設定のままでも「デモモード」（ブラウザ内保存＋モックデータ）で動作します。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI試着（Google Gemini の画像生成）。未設定ならレイヤー重ね合わせのみ。
# キーは https://aistudio.google.com/apikey で発行（画像生成は請求先アカウントの設定が必要）。
GEMINI_API_KEY=
# 使うモデル（省略時 gemini-2.5-flash-image、1枚 約$0.039）
# TRYON_MODEL=gemini-2.5-flash-image
