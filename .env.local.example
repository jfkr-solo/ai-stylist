# 未設定のままでも「デモモード」（ブラウザ内保存＋モックデータ）で動作します。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI試着（Google Gemini の画像生成）。どれか1つを設定（上ほど優先）。未設定ならレイヤー重ね合わせのみ。
# 1) Google Cloud（Vertex AI）のサービスアカウント鍵。ダウンロードした JSON の中身を1行で。無料トライアルの$300クレジットが使える
GOOGLE_CLOUD_CREDENTIALS=
# GOOGLE_CLOUD_LOCATION=global
# 2) Vertex AI のAPIキー
# GOOGLE_CLOUD_API_KEY=
# 3) Google AI Studio（https://aistudio.google.com/apikey）のキー。画像生成は前払いの請求設定が必要
GEMINI_API_KEY=
# 使うモデル（省略時 gemini-2.5-flash-image、1枚 約$0.039）
# TRYON_MODEL=gemini-2.5-flash-image
